<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>tn.eniso.computehive</groupId>
    <artifactId>computehive-root</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>ComputeHive :: Root</name>
    <description>Ordonnanceur de calculs GPU partagé, construit selon The Pyramid Architecture</description>

    <modules>
        <module>core</module>
        <module>contracts</module>
        <module>extensions</module>
        <module>drivers</module>
        <module>modules</module>
        <module>apps</module>
        <module>agent-simulator</module>
        <module>tests</module>
    </modules>

    <properties>
        <java.version>17</java.version>
        <maven.compiler.release>17</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <spring-boot.version>3.3.5</spring-boot.version>
        <grpc.version>1.66.0</grpc.version>
        <protobuf.version>3.25.5</protobuf.version>
        <archunit.version>1.3.0</archunit.version>
        <!-- 1.21.x : compatible avec les versions récentes de l'API Docker (CI et Docker Desktop) -->
        <testcontainers.version>1.21.4</testcontainers.version>
        <!-- Logs JSON (Logback), avec les champs du MDC : correlationId, jobId, workerId -->
        <logstash-logback-encoder.version>8.0</logstash-logback-encoder.version>
        <tomcat-annotations-api.version>6.0.53</tomcat-annotations-api.version>

        <os-maven-plugin.version>1.7.1</os-maven-plugin.version>
        <protobuf-maven-plugin.version>0.6.1</protobuf-maven-plugin.version>
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-enforcer-plugin.version>3.5.0</maven-enforcer-plugin.version>
        <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.5.2</maven-failsafe-plugin.version>

        <!--
            Règles de couches de la Pyramid Architecture, vérifiées par Maven Enforcer.
            Chaque sous-projet déclare sa couche en redéfinissant ces motifs interdits (jusqu'à cinq)
            (voir docs/adr/0003-verification-des-regles-de-dependances.md).
            "none:none" ne correspond à aucun artefact : par défaut, rien n'est interdit.
        -->
        <pyramid.banned.1>none:none</pyramid.banned.1>
        <pyramid.banned.2>none:none</pyramid.banned.2>
        <pyramid.banned.3>none:none</pyramid.banned.3>
        <pyramid.banned.4>none:none</pyramid.banned.4>
        <pyramid.banned.5>none:none</pyramid.banned.5>
    </properties>

