<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>tn.eniso.computehive</groupId>
        <artifactId>apps</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>app-modulith</artifactId>
    <name>ComputeHive :: App :: Modulith</name>
    <description>M/1 : tous les modules dans un seul processus.</description>

    <dependencies>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>core-service-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>core-ws-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>jobs-dal-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>jobs-service-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>jobs-ws-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>machines-dal-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>machines-service-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>machines-ws-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>scheduling-dal-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>scheduling-service-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>scheduling-ws-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>scheduling-ws-grpc</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>quotas-dal-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>quotas-service-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>quotas-ws-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>dashboard-service-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>dashboard-ws-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>files-dal-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>files-service-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>files-ws-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>checkpoint-storage-ws-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>file-storage-ws-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>driver-broker-memory</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>driver-notif-log</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>driver-storage-local</artifactId>
        </dependency>

        <!-- Exécution : serveur web, JPA, pilote PostgreSQL, santé de l'application, logs JSON -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Exposition des métriques au format Prometheus : GET /actuator/prometheus (ADR 0014) -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
        </dependency>

        <!-- Test de bout en bout : vraie application, vrai PostgreSQL, faux agents gRPC -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>agent-simulator</artifactId>
            <version>${project.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>app-modulith</finalName>
        <plugins>
            <!--
              Les tests d'intégration tournent après l'empaquetage : sans ce réglage, failsafe utiliserait le jar
              exécutable de Spring Boot, dont les classes sont rangées sous BOOT-INF/classes et donc introuvables.
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <classesDirectory>${project.build.outputDirectory}</classesDirectory>
                </configuration>
            </plugin>
            <!-- Jar exécutable : java -jar apps/app-modulith/target/app-modulith.jar -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
