<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>tn.eniso.computehive</groupId>
        <artifactId>apps</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>app-main</artifactId>
    <name>ComputeHive :: App :: Main</name>
    <description>M/P, processus principal : jobs, machines et quotas ; scheduling appelé à distance.</description>

    <!--
      Garde-fous de l'assemblage : scheduling tourne dans app-scheduling, jamais ici (deux ordonnanceurs placeraient
      les mêmes jobs) ; le broker en mémoire ne traverse pas les processus ; les agents ne parlent qu'à app-scheduling.
    -->
    <properties>
        <pyramid.banned.1>tn.eniso.computehive:scheduling-service-impl</pyramid.banned.1>
        <pyramid.banned.2>tn.eniso.computehive:scheduling-dal-*</pyramid.banned.2>
        <pyramid.banned.3>tn.eniso.computehive:scheduling-ws-*</pyramid.banned.3>
        <pyramid.banned.4>tn.eniso.computehive:driver-broker-memory</pyramid.banned.4>
        <pyramid.banned.5>tn.eniso.computehive:checkpoint-storage-ws-rest</pyramid.banned.5>
    </properties>

    <dependencies>
        <!-- Modules hébergés : implémentation locale -->
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>core-service-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>core-ws-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>jobs-dal-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>jobs-service-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>jobs-ws-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>machines-dal-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>machines-service-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>machines-ws-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>quotas-dal-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>quotas-service-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>quotas-ws-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>dashboard-service-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>dashboard-ws-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>files-dal-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>files-service-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>files-ws-rest</artifactId>
        </dependency>

        <!-- Module distant : proxy REST de la façade -->
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>scheduling-service-rest-cli</artifactId>
        </dependency>

        <!-- Drivers : Kafka entre les deux applications, notifications par e-mail -->
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>driver-broker-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>driver-notif-email</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>driver-storage-remote</artifactId>
        </dependency>

        <!-- Exécution : serveur web, JPA, pilote PostgreSQL, santé de l'application, logs JSON -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Exposition des métriques au format Prometheus : GET /actuator/prometheus (ADR 0014) -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>app-main</finalName>
        <plugins>
            <!-- Jar exécutable : java -jar apps/app-main/target/app-main.jar (copié dans l'image Docker) -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
