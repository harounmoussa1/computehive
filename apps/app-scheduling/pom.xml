<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>tn.eniso.computehive</groupId>
        <artifactId>apps</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>app-scheduling</artifactId>
    <name>ComputeHive :: App :: Scheduling</name>
    <description>M/P, processus extrait : scheduling, la porte gRPC et les checkpoints des agents ; jobs, machines et quotas appelés à distance.</description>

    <!--
      Garde-fous de l'assemblage : jobs, machines et quotas tournent dans app-main, jamais ici ; le broker en
      mémoire ne traverse pas les processus.
    -->
    <properties>
        <pyramid.banned.1>tn.eniso.computehive:jobs-service-impl</pyramid.banned.1>
        <pyramid.banned.2>tn.eniso.computehive:machines-service-impl</pyramid.banned.2>
        <pyramid.banned.3>tn.eniso.computehive:quotas-service-impl</pyramid.banned.3>
        <pyramid.banned.4>tn.eniso.computehive:driver-broker-memory</pyramid.banned.4>
        <pyramid.banned.5>tn.eniso.computehive:driver-notif-*</pyramid.banned.5>
    </properties>

    <dependencies>
        <!-- Module hébergé : implémentation locale, porte gRPC des agents, API interne -->
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>core-service-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>core-ws-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>scheduling-dal-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>scheduling-service-impl</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>scheduling-ws-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>scheduling-ws-grpc</artifactId>
        </dependency>

        <!-- Modules distants : proxys REST des façades -->
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>jobs-service-rest-cli</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>machines-service-rest-cli</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>quotas-service-rest-cli</artifactId>
        </dependency>

        <!-- Checkpoints des agents : API de dépôt et stockage distant simulé ; Kafka entre les deux applications -->
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>checkpoint-storage-ws-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>file-storage-ws-rest</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>driver-storage-remote</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>driver-broker-kafka</artifactId>
        </dependency>

        <!-- Exécution : serveur web, JPA, pilote PostgreSQL, santé de l'application, logs JSON -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!-- Exposition des métriques au format Prometheus : GET /actuator/prometheus (ADR 0014) -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>net.logstash.logback</groupId>
            <artifactId>logstash-logback-encoder</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>app-scheduling</finalName>
        <plugins>
            <!-- Jar exécutable : java -jar apps/app-scheduling/target/app-scheduling.jar (copié dans l'image Docker) -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
