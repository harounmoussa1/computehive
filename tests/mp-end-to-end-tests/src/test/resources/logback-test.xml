<configuration>
    <!-- Prioritaire sur le logback.xml du faux agent, présent sur le classpath de test. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{HH:mm:ss.SSS} %-5level [job=%X{jobId:-} worker=%X{workerId:-}] %logger{30} - %msg%n</pattern>
        </encoder>
    </appender>
    <logger name="tn.eniso.computehive" level="INFO"/>
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
