    <artifactId>remote-contract-tests</artifactId>
    <name>ComputeHive :: Tests :: Remote contracts</name>
    <description>
        Tests de contrat du mode M/P : chaque proxy service-rest-cli appelle le vrai contrôleur interne de son module
        (ws-rest, MockMvc) devant une façade simulée. Ils prouvent que les deux côtés parlent le même langage
        (chemins, JSON, erreurs), sans démarrer d'application.
    </description>

    <properties>
        <pyramid.banned.1>tn.eniso.computehive:*-service-impl</pyramid.banned.1>
        <pyramid.banned.2>tn.eniso.computehive:*-dal-*</pyramid.banned.2>
        <pyramid.banned.3>tn.eniso.computehive:driver-*</pyramid.banned.3>
        <pyramid.banned.4>tn.eniso.computehive:app-*</pyramid.banned.4>
    </properties>

