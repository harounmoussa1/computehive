    {
      "id": 14,
      "type": "state-timeline",
      "title": "Circuit breakers (Resilience4j)",
      "description": "Un circuit par module distant (M/P) et pour le stockage des checkpoints. Ouvert : les appels sont refusés tout de suite pendant un moment, au lieu d'attendre chacun leur délai.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 28,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "expr": "max by (name) (resilience4j_circuitbreaker_state{state=\"open\"}) * 2 + max by (name) (resilience4j_circuitbreaker_state{state=\"half_open\"})",
          "legendFormat": "{{name}}",
          "range": true,
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "fermé",
                  "color": "green",
                  "index": 0
                },
                "1": {
                  "text": "demi-ouvert",
                  "color": "yellow",
                  "index": 1
                },
                "2": {
                  "text": "ouvert",
                  "color": "red",
                  "index": 2
                }
              }
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        },
        "overrides": []
      },
      "options": {
        "showValue": "never",
        "mergeValues": true,
        "rowHeight": 0.8,
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": false
        }
      }
    },
