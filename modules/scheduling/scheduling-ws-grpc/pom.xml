<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>tn.eniso.computehive</groupId>
        <artifactId>scheduling</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>scheduling-ws-grpc</artifactId>
    <name>ComputeHive :: Scheduling :: WS gRPC</name>
    <description>Scheduling : couche ws-grpc (porte WorkerGateway des agents)</description>

    <properties>
        <pyramid.banned.1>tn.eniso.computehive:*-service-impl</pyramid.banned.1>
        <pyramid.banned.2>tn.eniso.computehive:*-dal-*</pyramid.banned.2>
        <pyramid.banned.3>tn.eniso.computehive:*-cli</pyramid.banned.3>
        <pyramid.banned.4>tn.eniso.computehive:driver-*</pyramid.banned.4>
    </properties>

    <dependencies>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>scheduling-service-api</artifactId>
        </dependency>
        <dependency>
            <groupId>tn.eniso.computehive</groupId>
            <artifactId>worker-proto</artifactId>
        </dependency>
        <!-- Serveur gRPC (Netty embarqué, sans conflit avec le Netty d'autres bibliothèques) -->
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-netty-shaded</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot</artifactId>
        </dependency>
        <!-- Métriques (ADR 0014) : contrat Micrometer seulement ; Prometheus est choisi par l'application -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-inprocess</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
